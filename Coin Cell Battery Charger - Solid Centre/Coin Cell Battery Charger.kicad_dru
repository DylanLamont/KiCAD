(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.2032mm))
)
(rule "Copper to edge clearance 1"
	(constraint edge_clearance (min 0.254mm))
)
(rule "Copper to hole clearance 1"
	(constraint hole_clearance (min 0.254mm))
)
(rule "Via style 1"
	(constraint via_diameter (min 0.508mm) (max 0.5588mm))
	(constraint hole_size (min 0.2032mm) (max 0.254mm))
	(condition "A.Via_Type == 'Through'")
)
(rule "Silk to soldermask clearance 1"
	(constraint silk_clearance (min 0.0254mm))
	(condition "L == 'F.Mask' || L == 'B.Mask'")
)
(rule "Minimum connection width 1"
	(constraint connection_width (min 0.1016mm))
)
(rule "Minimum thermal relief spoke count 1"
	(constraint min_resolved_spokes 1)
)
